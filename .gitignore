# создаем папку Lesson8
# git init
# Создаем файл .gitignore
# git add .
# git commit -m "Первый коммит"
# все что вы пропишите в этом файле будет игнорироваться гитом

# игнорирование по точному совпадению названия
secrets.txt
.env
.config
# спрятали от гит папку config_folder
/config_folder

# паттерны игнорирования
# шаблоны игнорирования
*.log
# чтобытамнибыло.log

# это что будет игнорировать?
.env*
# a* - все что начинается с буквы а
# *a - все что заканчивается на букву а
# .env
# .enviroinment
# .env.local

# *.* - игнорировать все файлы с точкой в названии

# /config_folder/*.json